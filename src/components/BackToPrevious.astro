---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="not-prose group inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="size-4 fill-none stroke-current stroke-2 transition-transform group-hover:-translate-x-0.5"
    aria-hidden="true"
  >
    <line x1="19" y1="12" x2="5" y2="12"></line>
    <polyline points="12 19 5 12 12 5"></polyline>
  </svg>
  <slot />
</a>
