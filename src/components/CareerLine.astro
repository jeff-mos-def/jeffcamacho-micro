---
import { getCollection } from "astro:content";

// A transit-style line of every role in the work collection, newest first.
// Stations link to the matching entry on the Work page.
const roles = (await getCollection("work"))
  .filter((entry) => entry.data.type === "work")
  .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const year = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", timeZone: "UTC" });
---

<div class="career-line">
  <div class="mb-5 flex items-baseline justify-between gap-4">
    <h2 class="section-title text-lg">Career line</h2>
    <a href="/work" class="link text-sm">Full history</a>
  </div>

  <ol class="stations">
    {
      roles.map((entry, i) => {
        const current = entry.data.dateEnd === "Current";
        return (
          <li class="station" style={`--i: ${i}`} data-current={current ? "true" : undefined}>
            <span class="station-year">{year(entry.data.dateStart)}</span>
            <span class="station-dot" aria-hidden="true" />
            <a href={`/work#${entry.id}`} class="station-body group">
              <span class="station-company">{entry.data.company}</span>
              <span class="station-role">
                {entry.data.role}
                {current && <span class="station-now">Current</span>}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .stations {
    position: relative;
    display: grid;
    gap: 0.35rem;
  }

  /* The line itself runs through the station column, top station to bottom station. */
  .stations::before {
    content: "";
    position: absolute;
    left: calc(3.25rem + 0.75rem + 0.4375rem - 2px);
    top: 0.85rem;
    bottom: 0.85rem;
    width: 4px;
    border-radius: 4px;
    background: var(--c-accent);
    transform-origin: top;
    animation: draw-line 900ms cubic-bezier(0.3, 0.7, 0.2, 1) both;
  }

  .station {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 0.875rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
  }

  .station-year {
    padding-top: 0.45rem;
    text-align: right;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--c-muted);
  }

  .station-dot {
    position: relative;
    z-index: 1;
    margin-top: 0.55rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 9999px;
    border: 3px solid var(--c-accent);
    background: var(--c-paper);
    animation: pop 300ms ease-out both;
    animation-delay: calc(150ms + var(--i) * 90ms);
  }

  .station[data-current] .station-dot {
    background: var(--c-accent);
    box-shadow: 0 0 0 4px var(--c-accent-wash);
  }

  .station-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.3rem 0.6rem;
    margin-left: -0.6rem;
    border-radius: 0.5rem;
    transition: background-color 150ms ease;
  }

  .station-body:hover {
    background: color-mix(in srgb, var(--c-line) 45%, transparent);
  }

  .station-company {
    color: var(--c-ink);
    font-weight: 650;
    font-variation-settings: "wdth" 106;
    line-height: 1.3;
  }

  .station-role {
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--c-muted);
  }

  .station-now {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    line-height: 1.2rem;
    color: var(--c-accent-ink);
    background: var(--c-accent-wash);
  }

  @keyframes draw-line {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stations::before,
    .station-dot {
      animation: none;
    }
  }
</style>
