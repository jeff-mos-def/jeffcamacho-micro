<div id="preview" data-pagefind-ignore hidden></div>

<style is:global>
  a.internal.new {
    color: rgb(239 68 68);
    border-bottom: 1px dashed currentColor;
  }
  .dark a.internal.new {
    color: rgb(248 113 113);
  }
</style>

<style>
  #preview {
    position: absolute;
    z-index: 50;
    max-width: 22rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.5rem;
    background: white;
    border: 1px solid rgb(229 229 229);
    color: rgb(64 64 64);
    font-size: 0.85rem;
    line-height: 1.45;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    pointer-events: none;
  }
  :global(.dark) #preview {
    background: rgb(23 23 23);
    border-color: rgb(64 64 64);
    color: rgb(212 212 212);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
  }
  #preview[hidden] {
    display: none;
  }
  #preview strong {
    display: block;
    margin-bottom: 0.35rem;
    color: rgb(23 23 23);
  }
  :global(.dark) #preview strong {
    color: white;
  }
  #preview p {
    margin: 0;
  }
  @media (max-width: 1023px) {
    #preview {
      display: none;
    }
  }
</style>

<script>
  type Excerpt = { title: string; excerpt: string };
  type ExcerptMap = Record<string, Excerpt>;

  let excerpts: ExcerptMap | null = null;

  async function loadExcerpts(): Promise<ExcerptMap> {
    if (excerpts) return excerpts;
    const loaded: ExcerptMap = await fetch("/excerpts.json").then((r) =>
      r.json()
    );
    excerpts = loaded;
    return loaded;
  }

  function initLinkPreview() {
    const box = document.getElementById("preview");
    if (!box) return;

    box.hidden = true;
    let timer: number | undefined;

    const links = document.querySelectorAll<HTMLAnchorElement>(
      'a[href^="/projects/"]'
    );

    links.forEach((a) => {
      if (a.dataset.previewBound) return;
      a.dataset.previewBound = "true";

      a.addEventListener("mouseenter", () => {
        timer = window.setTimeout(async () => {
          const map = await loadExcerpts();
          const key = new URL(a.href).pathname.replace(/\/$/, "");
          const hit = map[key];
          if (!hit) return;

          box.innerHTML = "<strong></strong><p></p>";
          const titleEl = box.querySelector("strong");
          const bodyEl = box.querySelector("p");
          if (!titleEl || !bodyEl) return;

          titleEl.textContent = hit.title;
          bodyEl.textContent = hit.excerpt + "\u2026";

          box.hidden = false;
          const r = a.getBoundingClientRect();
          const w = box.offsetWidth;
          let left = r.left + window.scrollX;
          if (left + w > window.innerWidth - 12) {
            left = window.innerWidth - w - 12;
          }
          box.style.top = `${r.bottom + window.scrollY + 6}px`;
          box.style.left = `${Math.max(12, left)}px`;
        }, 250);
      });

      a.addEventListener("mouseleave", () => {
        clearTimeout(timer);
        box.hidden = true;
      });
    });
  }

  initLinkPreview();
  document.addEventListener("astro:page-load", initLinkPreview);
</script>