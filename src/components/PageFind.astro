---
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center bg-[#0e141d]/50 p-4 pt-[12vh] backdrop-blur-sm sm:p-6 sm:pt-[12vh]"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[76vh] w-full max-w-screen-sm flex-col overflow-auto rounded-xl border border-line bg-surface px-4 py-4 shadow-2xl"
    >
      <div id="search" class="pagefind-ui"></div>
      <p class="mr-1 pt-4 text-right text-xs text-muted">
        Press <kbd class="rounded border border-line px-1.5 font-sans">Esc</kbd> or click outside to close
      </p>
    </div>
  </div>
</aside>

<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function initPagefind() {
    const el = document.getElementById("search");
    if (!el || el.dataset.initialized) return;
    if (typeof PagefindUI === "undefined") {
      setTimeout(initPagefind, 50);
      return;
    }
    new PagefindUI({
      element: "#search",
      showImages: false,
      excerptLength: 15,
      resetStyles: false,
    });
    el.dataset.initialized = "true";
  }

  initPagefind();
  document.addEventListener("astro:page-load", initPagefind);

  function openPagefind() {
    const searchDiv = document.getElementById("search");
    const search = searchDiv?.querySelector("input");
    setTimeout(() => {
      search?.focus();
    }, 0);
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");
  }

  function closePagefind() {
    const input = document.getElementById("search")?.querySelector("input");
    if (input) {
      input.value = "";
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    } else if (e.key === "Escape") {
      closePagefind();
    }
  });

  document.addEventListener("click", (event) => {
    if (event.target.classList.contains("pagefind-ui__result-link")) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-primary: var(--c-accent-ink);
    --pagefind-ui-text: var(--c-text);
    --pagefind-ui-background: var(--c-surface);
    --pagefind-ui-border: var(--c-line);
    --pagefind-ui-tag: var(--c-paper);
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__result-link {
    color: var(--c-ink);
  }

  #search .pagefind-ui__result-link:hover {
    color: var(--c-accent-ink);
  }

  #search mark {
    background: var(--c-accent-wash);
    color: var(--c-ink);
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
    color: var(--c-muted);
  }
</style>
