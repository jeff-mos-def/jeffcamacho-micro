---
const { prevPost, nextPost } = Astro.props;
---

<nav class="not-prose grid gap-3 border-t border-line pt-8 sm:grid-cols-2" aria-label="More posts">
  {
    prevPost?.id ? (
      <a href={`/blog/${prevPost.id}`} class="post-nav group">
        <span class="meta text-xs">Newer post</span>
        <span class="post-nav-title">{prevPost.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }

  {
    nextPost?.id ? (
      <a href={`/blog/${nextPost.id}`} class="post-nav group sm:text-right">
        <span class="meta text-xs">Older post</span>
        <span class="post-nav-title">{nextPost.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
</nav>

<style>
  .post-nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    transition: border-color 150ms ease;
  }

  .post-nav:hover {
    border-color: var(--c-line-strong);
  }

  .post-nav-title {
    color: var(--c-ink);
    font-weight: 600;
    line-height: 1.35;
    font-variation-settings: "wdth" 104;
    transition: color 150ms ease;
  }

  .post-nav:hover .post-nav-title {
    color: var(--c-accent-ink);
  }
</style>
