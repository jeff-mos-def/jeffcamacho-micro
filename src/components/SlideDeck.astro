---
import RoadmapCard from './RoadmapCard.astro';
import type { RoadmapItem } from '../types/roadmap';

interface Props {
  items: RoadmapItem[];
}

const { items } = Astro.props;
---

<div class="deck" data-deck>
  <div
    class="deck__track"
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Homelab roadmap slides. Use the left and right arrow keys to move between slides."
    data-track
  >
    {items.map((item, i) => (
      <div
        class="deck__slide"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${items.length}`}
      >
        <RoadmapCard item={item} />
      </div>
    ))}
  </div>

  <div class="deck__controls">
    <button type="button" class="deck__btn" data-prev aria-label="Previous slide">
      &#8592; Prev
    </button>
    <p class="deck__counter" aria-live="polite" data-counter>
      1 / {items.length}
    </p>
    <button type="button" class="deck__btn" data-next aria-label="Next slide">
      Next &#8594;
    </button>
  </div>
</div>

<style>
  .deck {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .deck__track {
    display: grid;
    grid-auto-flow: column;
    /* One slide fills the track, so exactly one is on screen at a time. */
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0.25rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--hr-line) transparent;
  }

  .deck__track:focus-visible {
    outline: 2px solid var(--hr-accent);
    outline-offset: 3px;
    border-radius: 12px;
  }

  .deck__slide {
    scroll-snap-align: center;
    display: flex;
  }

  .deck__slide > :global(*) {
    flex: 1;
  }

  .deck__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .deck__btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.4rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--hr-line);
    background: var(--hr-surface);
    color: var(--hr-text);
    cursor: pointer;
  }

  .deck__btn:hover:not(:disabled) {
    border-color: var(--hr-accent);
    color: var(--hr-accent);
  }

  .deck__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .deck__counter {
    margin: 0;
    font-family: var(--hr-font-mono);
    font-size: 0.78rem;
    color: var(--hr-muted);
    min-width: 4ch;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .deck__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function initDeck(deck: HTMLElement) {
    const track = deck.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(deck.querySelectorAll<HTMLElement>('[data-slide]'));
    const counter = deck.querySelector<HTMLElement>('[data-counter]');
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]');
    const next = deck.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || slides.length === 0) return;

    let current = 0;

    function render() {
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
    }

    function goTo(index: number) {
      const clamped = Math.max(0, Math.min(index, slides.length - 1));
      slides[clamped].scrollIntoView({ block: 'nearest', inline: 'center' });
      current = clamped;
      render();
    }

    // Keep the counter honest when the user swipes or drags the scrollbar.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            current = slides.indexOf(entry.target as HTMLElement);
            render();
          }
        }
      },
      { root: track, threshold: 0.9 }
    );
    slides.forEach((slide) => observer.observe(slide));

    // Arrow keys only apply while the track itself has focus, so normal
    // page scrolling is left alone.
    track.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));

    render();
  }


  /* Runs on DOM ready and isolates each instance, so an unrelated script
     throwing elsewhere on the page cannot stop this component from
     initialising. */
  function bootDecks() {
    document.querySelectorAll<HTMLElement>('[data-deck]').forEach((el) => {
      // Both listeners can fire for the same element on a first load, so
      // each node is only ever wired up once.
      if (el.dataset.initialised === 'true') return;
      el.dataset.initialised = 'true';
      try {
        initDeck(el);
      } catch (error) {
        console.error('Slide deck failed to initialise', error);
      }
    });
  }

  /* `astro:page-load` fires on first load and after every view transition,
     which a plain DOMContentLoaded listener misses because the document is
     never reloaded during a client-side navigation. */
  document.addEventListener('astro:page-load', bootDecks);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootDecks);
  } else {
    bootDecks();
  }
</script>
