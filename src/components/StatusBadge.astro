---
export type Status = 'To Do' | 'Doing' | 'Done' | 'OBE' | 'Backlog';

interface Props {
  status: Status;
}

const { status } = Astro.props;

// Each status gets a marker shape and color so it reads without relying on color alone.
const styles: Record<Status, { dot: string; ring: boolean }> = {
  'Doing': { dot: 'bg-accent', ring: false },
  'To Do': { dot: 'bg-amber-500', ring: false },
  'Backlog': { dot: 'bg-transparent border-amber-500', ring: true },
  'Done': { dot: 'bg-emerald-600 dark:bg-emerald-400', ring: false },
  'OBE': { dot: 'bg-transparent border-muted', ring: true },
};

const style = styles[status] ?? { dot: 'bg-muted', ring: false };
---

<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line px-2 py-0.5 text-xs font-medium text-text">
  <span class:list={["size-2 rounded-full", style.dot, style.ring && "border-2"]} aria-hidden="true"></span>
  {status}
</span>
