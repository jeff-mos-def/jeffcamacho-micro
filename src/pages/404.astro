---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { SITE } from "@consts";
---

<Layout title="404" description={SITE.DESCRIPTION}>
  <Container>
    <div class="mt-16 space-y-5">
      <h1 class="animate display text-6xl sm:text-7xl">404</h1>
      <p class="animate font-serif text-xl text-muted">
        This page doesn't exist. It may have moved, or the link has a typo. Try search, or start from the home page.
      </p>
      <div class="animate">
        <BackToPrevious href="/">Go to home page</BackToPrevious>
      </div>
    </div>
  </Container>
</Layout>
