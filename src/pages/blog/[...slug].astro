---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import Giscus from "@components/Giscus.astro";
import Lightbox from "@components/Lightbox.astro";
import TagChips from "@components/TagChips.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

async function getProjectData(projectSlug: string) {
  const projects = (await getCollection("projects")).filter(
    (project) => !project.data.draft
  );
  const project = projects.find((p) => `/projects/${p.id}` === projectSlug);
  return project
    ? { title: project.data.title, slug: `/projects/${project.id}` }
    : null;
}

type Props = CollectionEntry<"blog">;

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getNextPost() {
  let postIndex;
  for (const post of posts) {
    if (post.id === Astro.params.slug) {
      postIndex = posts.indexOf(post);
      return posts[postIndex + 1];
    }
  }
}

function getPrevPost() {
  let postIndex;
  for (const post of posts) {
    if (post.id === Astro.params.slug) {
      postIndex = posts.indexOf(post);
      return posts[postIndex - 1];
    }
  }
}

const nextPost = getNextPost();
const prevPost = getPrevPost();

const post = Astro.props;
const { Content, headings } = await render(post);
const linkedProject = post.data.linkedProject
  ? await getProjectData(post.data.linkedProject)
  : null;
const projectBoardLink = post.data.projectBoard ?? null;

// Build a two level outline: h2 sections with their h3 subheadings
type TocHeading = {
  depth: number;
  slug: string;
  text: string;
  subheadings: TocHeading[];
};

function buildToc(raw: { depth: number; slug: string; text: string }[]) {
  const toc: TocHeading[] = [];
  let current: TocHeading | null = null;

  for (const h of raw ?? []) {
    if (h.depth === 2) {
      current = { ...h, subheadings: [] };
      toc.push(current);
    } else if (h.depth === 3 && current) {
      current.subheadings.push({ ...h, subheadings: [] });
    }
  }
  return toc;
}

const toc = buildToc(headings);
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <div data-pagefind-body>
      <div class="animate" id="top" data-pagefind-ignore>
        <BackToPrevious href="/blog">Back to blog</BackToPrevious>
      </div>

      <header class="mb-12 mt-8 space-y-5">
        <p class="animate meta" data-pagefind-ignore>
          <FormattedDate date={post.data.date} />
          <span aria-hidden="true" class="mx-1.5">/</span>
          {readingTime(post.body ?? "")}
        </p>
        <h1 class="animate display text-[2rem] leading-[1.1] sm:text-[2.4rem]">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p class="animate font-serif text-xl leading-relaxed text-muted">
            {post.data.description}
          </p>
        )}
        <div class="animate flex flex-wrap items-center gap-x-5 gap-y-3" data-pagefind-ignore>
          <TagChips tags={post.data.tags} />
          {linkedProject && (
            <a href={linkedProject.slug} class="link text-sm">
              Related project: {linkedProject.title}
            </a>
          )}
          {projectBoardLink && (
            <a href={projectBoardLink} class="link text-sm" target="_blank" rel="noopener noreferrer">
              GitHub project board
            </a>
          )}
        </div>
      </header>

      <div class="relative">

        {toc.length > 0 && (
          <aside class="animate absolute bottom-0 top-0 -left-60 hidden w-48 min-[1200px]:block" data-pagefind-ignore>
            <nav class="sticky top-24 flex h-fit max-h-[calc(100vh-8rem)] flex-col pr-4" aria-label="Contents">
              <h2 class="side-label">Contents</h2>
              <div class="thin-scroll overflow-y-auto overscroll-contain pr-1">
                <ul class="space-y-2.5 border-l border-line">
                  <li>
                    <a
                      href="#top"
                      data-toc-link
                      class="toc-link text-muted"
                    >
                      Top
                    </a>
                  </li>
                  {toc.map((heading) => (
                    <li class="space-y-1.5">
                      <a
                        href={`#${heading.slug}`}
                        data-toc-link
                        class="toc-link text-text"
                      >
                        {heading.text}
                      </a>
                      {heading.subheadings.length > 0 && (
                        <ul class="space-y-1.5">
                          {heading.subheadings.map((sub) => (
                            <li>
                              <a
                                href={`#${sub.slug}`}
                                data-toc-link
                                class="toc-link toc-sub text-muted"
                              >
                                {sub.text}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          </aside>
        )}

        <article class="animate blog-content reading">
          <Content />
        </article>
      </div>
    </div>

    <div class="mt-20 space-y-20" data-pagefind-ignore>
      <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      <Giscus />
    </div>
    <Lightbox />
  </Container>
</Layout>

<style>
  /* Keep anchor jumps clear of the sticky header */
  .blog-content :global(h2),
  .blog-content :global(h3) {
    scroll-margin-top: 6rem;
  }

  .toc-link {
    display: block;
    margin-left: -1px;
    padding-left: 0.85rem;
    border-left: 2px solid transparent;
    font-size: 0.85rem;
    line-height: 1.35;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .toc-sub {
    padding-left: 1.6rem;
    font-size: 0.8rem;
  }

  .toc-link:hover {
    color: var(--c-ink);
  }

  .toc-link:global(.toc-active) {
    border-left-color: var(--c-accent);
  }
</style>

<script>
  function initPostToc() {
    const links = Array.from(
      document.querySelectorAll("[data-toc-link]")
    ) as HTMLAnchorElement[];
    if (!links.length) return;

    const entries: { link: HTMLAnchorElement; target: HTMLElement }[] = [];

    links.forEach((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      const target = document.getElementById(id);
      if (target) entries.push({ link, target });
    });

    if (!entries.length) return;

    let active: HTMLAnchorElement | null = null;
    let ticking = false;
    let pinned = false;

    const setActive = (link: HTMLAnchorElement | null) => {
      if (link === active) return;
      active?.classList.remove("toc-active");
      link?.classList.add("toc-active");
      active = link;
    };

    const update = () => {
      ticking = false;
      if (pinned) return;

      // Bottom of the page always belongs to the last section
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
      if (atBottom) {
        setActive(entries[entries.length - 1].link);
        return;
      }

      // Otherwise the last target whose top has passed the header line
      let current: HTMLAnchorElement | null = null;
      for (const entry of entries) {
        if (entry.target.getBoundingClientRect().top <= 110) {
          current = entry.link;
        } else {
          break;
        }
      }

      setActive(current);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // A click wins over scroll math until the reader moves on their own,
    // so late layout shifts cannot hand the highlight to the section above.
    const release = () => {
      if (!pinned) return;
      pinned = false;
      onScroll();
    };

    entries.forEach(({ link }) => {
      link.addEventListener("click", () => {
        pinned = true;
        setActive(link);
      });
    });

    window.addEventListener("wheel", release, { passive: true });
    window.addEventListener("touchmove", release, { passive: true });
    window.addEventListener("keydown", release);

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  initPostToc();
  document.addEventListener("astro:page-load", initPostToc);
</script>