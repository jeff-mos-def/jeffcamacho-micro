---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import Giscus from "@components/Giscus.astro";
import Lightbox from "@components/Lightbox.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

async function getProjectData(projectSlug: string) {
  const projects = (await getCollection("projects")).filter(
    (project) => !project.data.draft
  );
  const project = projects.find((p) => `/projects/${p.id}` === projectSlug);
  return project
    ? { title: project.data.title, slug: `/projects/${project.id}` }
    : null;
}

type Props = CollectionEntry<"blog">;

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getNextPost() {
  let postIndex;
  for (const post of posts) {
    if (post.id === Astro.params.slug) {
      postIndex = posts.indexOf(post);
      return posts[postIndex + 1];
    }
  }
}

function getPrevPost() {
  let postIndex;
  for (const post of posts) {
    if (post.id === Astro.params.slug) {
      postIndex = posts.indexOf(post);
      return posts[postIndex - 1];
    }
  }
}

const nextPost = getNextPost();
const prevPost = getPrevPost();

const post = Astro.props;
const { Content, headings } = await render(post);
const linkedProject = post.data.linkedProject
  ? await getProjectData(post.data.linkedProject)
  : null;
const projectBoardLink = post.data.projectBoard ?? null;

// Build a two level outline: h2 sections with their h3 subheadings
type TocHeading = {
  depth: number;
  slug: string;
  text: string;
  subheadings: TocHeading[];
};

function buildToc(raw: { depth: number; slug: string; text: string }[]) {
  const toc: TocHeading[] = [];
  let current: TocHeading | null = null;

  for (const h of raw ?? []) {
    if (h.depth === 2) {
      current = { ...h, subheadings: [] };
      toc.push(current);
    } else if (h.depth === 3 && current) {
      current.subheadings.push({ ...h, subheadings: [] });
    }
  }
  return toc;
}

const toc = buildToc(headings);
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate" id="top">
      <BackToPrevious href="/blog">Back to blog</BackToPrevious>
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body ?? "")}
        </div>
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="px-2 py-1 text-xs font-medium rounded bg-neutral-200 dark:bg-neutral-800 text-black dark:text-white hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      )}
      {linkedProject && (
        <div class="animate mt-4">
          <span class="font-semibold">Related Project:</span>{" "}
          <a href={linkedProject.slug} class="text-blue-500 hover:underline">
            {linkedProject.title}
          </a>
        </div>
      )}
      {projectBoardLink && (
        <div class="animate mt-4">
          <span class="font-semibold">Project Board:</span>{" "}
          <a href={projectBoardLink} class="text-blue-500 hover:underline" target="_blank" rel="noopener noreferrer">
            GitHub Project Board
          </a>
        </div>
      )}
    </div>

    <div class="relative w-full">

      {toc.length > 0 && (
        <aside class="animate hidden lg:block lg:absolute lg:top-0 lg:bottom-0 lg:-left-60 lg:w-48" data-pagefind-ignore>
          <nav class="lg:sticky lg:top-24 h-fit lg:max-h-[calc(100vh-8rem)] flex flex-col space-y-2 pr-4">
            <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-500 mb-4">
              Contents
            </h2>
            <div class="overflow-y-auto overscroll-contain pr-1 toc-scroll">
              <ul class="space-y-3">
                <li>
                  <a
                    href="#top"
                    data-toc-link
                    class="block text-sm text-neutral-500 dark:text-neutral-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
                  >
                    Top
                  </a>
                </li>
                {toc.map((heading) => (
                  <li class="space-y-1.5">
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link
                      class="block text-sm text-neutral-700 dark:text-neutral-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
                    >
                      {heading.text}
                    </a>
                    {heading.subheadings.length > 0 && (
                      <ul class="pl-3 space-y-1.5 border-l border-neutral-200 dark:border-neutral-800">
                        {heading.subheadings.map((sub) => (
                          <li>
                            <a
                              href={`#${sub.slug}`}
                              data-toc-link
                              class="block text-xs text-neutral-500 dark:text-neutral-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
                            >
                              {sub.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        </aside>
      )}

      <article class="animate blog-content">
        <Content />
        <div class="mt-24">
          <PostNavigation prevPost={prevPost} nextPost={nextPost} />
        </div>
        <div class="mt-24">
          <Giscus />
        </div>
      </article>

    </div>
    <Lightbox />
  </Container>
</Layout>

<style>
  /* Keep anchor jumps clear of the sticky header */
  .blog-content :global(h2),
  .blog-content :global(h3) {
    scroll-margin-top: 6rem;
  }

  .toc-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgb(212 212 212) transparent;
  }
  :global(.dark) .toc-scroll {
    scrollbar-color: rgb(64 64 64) transparent;
  }
  .toc-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .toc-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(212 212 212);
    border-radius: 9999px;
  }
  :global(.dark) .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(64 64 64);
  }

  .toc-active {
    color: rgb(59 130 246);
    font-weight: 600;
  }
</style>

<script>
  function initPostToc() {
    const links = Array.from(
      document.querySelectorAll("[data-toc-link]")
    ) as HTMLAnchorElement[];
    if (!links.length) return;

    const entries: { link: HTMLAnchorElement; target: HTMLElement }[] = [];

    links.forEach((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      const target = document.getElementById(id);
      if (target) entries.push({ link, target });
    });

    if (!entries.length) return;

    let active: HTMLAnchorElement | null = null;
    let ticking = false;
    let pinned = false;

    const setActive = (link: HTMLAnchorElement | null) => {
      if (link === active) return;
      active?.classList.remove("toc-active");
      link?.classList.add("toc-active");
      active = link;
    };

    const update = () => {
      ticking = false;
      if (pinned) return;

      // Bottom of the page always belongs to the last section
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
      if (atBottom) {
        setActive(entries[entries.length - 1].link);
        return;
      }

      // Otherwise the last target whose top has passed the header line
      let current: HTMLAnchorElement | null = null;
      for (const entry of entries) {
        if (entry.target.getBoundingClientRect().top <= 110) {
          current = entry.link;
        } else {
          break;
        }
      }

      setActive(current);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // A click wins over scroll math until the reader moves on their own,
    // so late layout shifts cannot hand the highlight to the section above.
    const release = () => {
      if (!pinned) return;
      pinned = false;
      onScroll();
    };

    entries.forEach(({ link }) => {
      link.addEventListener("click", () => {
        pinned = true;
        setActive(link);
      });
    });

    window.addEventListener("wheel", release, { passive: true });
    window.addEventListener("touchmove", release, { passive: true });
    window.addEventListener("keydown", release);

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  initPostToc();
  document.addEventListener("astro:page-load", initPostToc);
</script>