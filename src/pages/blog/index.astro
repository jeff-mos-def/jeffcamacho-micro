---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import PostRow from "@components/PostRow.astro";
import { BLOG } from "@consts";
import { tagLabel, tagOrder, TAGS } from "@lib/tags";

// 1. Fetch all blog posts and sort them newest to oldest
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 2. Group posts by Year, then by Month
const groupedPosts = posts.reduce((acc, post) => {
  const date = new Date(post.data.date);
  const year = date.getFullYear();
  const month = date.toLocaleString("default", { month: "long" });

  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];

  acc[year][month].push(post);
  return acc;
}, {} as Record<number, Record<string, typeof posts>>);

// 3. Sort the years in descending order (most recent first)
const sortedYears = Object.entries(groupedPosts).sort(
  ([yearA], [yearB]) => Number(yearB) - Number(yearA)
);

// 4. Build tag counts across all published posts
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
// Taxonomy order, so the filter list matches the Topics list elsewhere on the site
const sortedTags = Array.from(tagCounts.entries()).sort(
  ([tagA], [tagB]) => tagOrder(tagA) - tagOrder(tagB)
);
const VISIBLE_TAG_LIMIT = 10;
const hiddenTagCount = Math.max(0, sortedTags.length - VISIBLE_TAG_LIMIT);
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      <header class="animate space-y-3">
        <h1 class="display text-5xl sm:text-6xl">Blog</h1>
        <p class="meta text-base">{posts.length} posts. {BLOG.DESCRIPTION}</p>
      </header>

      <!-- Below the sidebar breakpoint, topics are a row of links instead of a filter -->
      <nav class="animate min-[1200px]:hidden" aria-label="Topics">
        <ul class="flex flex-wrap gap-1.5">
          {TAGS.filter((t) => tagCounts.has(t.slug)).map((t) => (
            <li>
              <a href={`/tags/${t.slug}`} class="chip">
                {t.label}
                <span class="ml-1.5 tabular-nums opacity-70">{tagCounts.get(t.slug)}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="relative">

        <aside class="animate absolute bottom-0 top-0 -left-60 hidden w-48 min-[1200px]:block">
          <nav class="sticky top-24 h-fit pr-4" aria-label="Archive">
            <h2 class="side-label">Archive</h2>
            <ul class="space-y-4">
              {sortedYears.map(([year, months]) => (
                <li class="space-y-1.5">
                  <a
                    href={`#arch-${year}`}
                    class="block text-sm font-semibold text-ink transition-colors hover:text-accent-ink"
                  >
                    {year}
                  </a>
                  <ul class="space-y-1 border-l border-line pl-3">
                    {Object.keys(months).map((month) => (
                      <li>
                        <a
                          href={`#arch-${year}-${month.toLowerCase()}`}
                          class="block text-[0.8rem] text-muted transition-colors hover:text-accent-ink"
                        >
                          {month}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <aside class="animate absolute bottom-0 top-0 -right-[15.5rem] hidden w-52 min-[1200px]:block">
          <nav class="sticky top-24 flex h-fit max-h-[calc(100vh-8rem)] flex-col pl-4" aria-label="Filter by topic">
            <h2 class="side-label">Filter by topic</h2>
            <div
              data-tag-scroll
              data-visible-limit={VISIBLE_TAG_LIMIT}
              class="thin-scroll max-h-[65vh] overflow-y-auto overscroll-contain pr-1"
            >
            <ul class="space-y-1">
              {sortedTags.map(([tag, count], i) => (
                <li
                  class={i >= VISIBLE_TAG_LIMIT ? "hidden" : undefined}
                  data-tag-overflow={i >= VISIBLE_TAG_LIMIT ? "true" : undefined}
                >
                  <label class="tag-option">
                    <span class="flex min-w-0 items-center gap-2">
                      <input
                        type="checkbox"
                        value={tag}
                        data-tag-filter
                        class="size-3.5 flex-shrink-0 accent-[var(--c-accent)]"
                      />
                      <span class="text-[0.8rem] leading-snug">
                        {tagLabel(tag)}
                      </span>
                    </span>
                    <span class="flex-shrink-0 text-xs tabular-nums text-muted">
                      {count}
                    </span>
                  </label>
                </li>
              ))}
            </ul>
            </div>
            {hiddenTagCount > 0 && (
              <button
                type="button"
                data-tag-toggle
                data-hidden-count={hiddenTagCount}
                class="mt-3 text-left text-xs font-medium text-muted transition-colors hover:text-accent-ink"
              >
                {`Show ${hiddenTagCount} more`}
              </button>
            )}
            <button
              type="button"
              data-tag-clear
              class="mt-4 hidden text-left text-xs text-muted underline underline-offset-2 transition-colors hover:text-accent-ink"
            >
              Clear filters
            </button>
            <p
              data-tag-empty
              class="mt-4 hidden text-xs text-muted"
            >
              No posts match all selected topics. Clear a filter to see more.
            </p>
          </nav>
        </aside>

        <div class="min-w-0 space-y-14" style="--date-col: 4rem">
          {sortedYears.map(([year, months]) => (
            <section class="animate scroll-mt-24" id={`arch-${year}`} data-year-group>
              <h2 class="section-title flex items-baseline justify-between border-b-2 border-ink pb-2 text-3xl">
                {year}
                <span class="meta text-sm font-normal">
                  {Object.values(months).flat().length} posts
                </span>
              </h2>

              {Object.entries(months).map(([month, monthPosts]) => (
                <div class="scroll-mt-24 pt-6" id={`arch-${year}-${month.toLowerCase()}`} data-month-group>
                  <h3 class="text-sm font-semibold text-muted">
                    {month}
                  </h3>

                  <ul class="divide-y divide-line">
                    {monthPosts.map((post) => (
                      <li data-post-tags={(post.data.tags ?? []).join("|")}>
                        <PostRow post={post} showYear={false} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ))}
        </div>

      </div>
    </div>
  </Container>
</Layout>

<style>
  .tag-option {
    display: flex;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--c-text);
    transition: background-color 150ms ease;
  }

  .tag-option:hover {
    background: color-mix(in srgb, var(--c-line) 45%, transparent);
  }

  .tag-option:has(input:checked) {
    color: var(--c-ink);
    background: var(--c-accent-wash);
  }
</style>

<script>
  function initTagFilter() {
    const boxes = Array.from(
      document.querySelectorAll("input[data-tag-filter]")
    ) as HTMLInputElement[];
    if (!boxes.length) return;

    const postItems = Array.from(document.querySelectorAll("[data-post-tags]"));
    const monthGroups = Array.from(document.querySelectorAll("[data-month-group]"));
    const yearGroups = Array.from(document.querySelectorAll("[data-year-group]"));
    const clearBtn = document.querySelector("[data-tag-clear]");
    const emptyMsg = document.querySelector("[data-tag-empty]");
    const toggleBtn = document.querySelector("[data-tag-toggle]");
    const scrollBox = document.querySelector("[data-tag-scroll]");
    const limit = Number(scrollBox?.getAttribute("data-visible-limit") || 10);

    let expanded = false;

    const apply = () => {
      const selected = boxes.filter((b) => b.checked).map((b) => b.value);

      // 1. Filter posts: a post must carry every selected tag
      const availableTags = new Set<string>();
      let visibleCount = 0;

      postItems.forEach((item) => {
        const tags = (item.getAttribute("data-post-tags") || "")
          .split("|")
          .filter(Boolean);
        const match = selected.every((t) => tags.includes(t));
        item.classList.toggle("hidden", !match);
        if (match) {
          visibleCount++;
          tags.forEach((t) => availableTags.add(t));
        }
      });

      // 2. Collapse empty month and year groups
      monthGroups.forEach((group) => {
        const has = group.querySelector("[data-post-tags]:not(.hidden)");
        group.classList.toggle("hidden", !has);
      });

      yearGroups.forEach((group) => {
        const has = group.querySelector("[data-month-group]:not(.hidden)");
        group.classList.toggle("hidden", !has);
      });

      // 3. Drop tags with no remaining content, then re-window the top N
      const available: { li: Element; box: HTMLInputElement }[] = [];

      boxes.forEach((box) => {
        const li = box.closest("li");
        if (!li) return;
        const isAvailable = box.checked || availableTags.has(box.value);
        if (isAvailable) {
          available.push({ li, box });
        } else {
          li.classList.add("hidden");
        }
      });

      let hiddenAvailable = 0;
      available.forEach((entry, i) => {
        const within = expanded || entry.box.checked || i < limit;
        entry.li.classList.toggle("hidden", !within);
        if (!within) hiddenAvailable++;
      });

      // 4. Controls
      if (toggleBtn) {
        const showToggle = expanded ? available.length > limit : hiddenAvailable > 0;
        toggleBtn.classList.toggle("hidden", !showToggle);
        toggleBtn.textContent = expanded
          ? "Show less"
          : `Show ${hiddenAvailable} more`;
      }

      if (clearBtn) clearBtn.classList.toggle("hidden", selected.length === 0);
      if (emptyMsg) emptyMsg.classList.toggle("hidden", visibleCount !== 0);
    };

    boxes.forEach((b) => b.addEventListener("change", apply));

    if (toggleBtn) {
      toggleBtn.addEventListener("click", () => {
        expanded = !expanded;
        apply();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        boxes.forEach((b) => (b.checked = false));
        apply();
      });
    }

    apply();
  }

  initTagFilter();
  document.addEventListener("astro:page-load", initTagFilter);
</script>