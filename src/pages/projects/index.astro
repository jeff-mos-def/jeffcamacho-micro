---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { PROJECTS } from "@consts";

// Fetch projects and blogs
const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf());

const blogs = (await getCollection("blog"))
  .filter((blog) => !blog.data.draft);

// Group projects by status
const groupedProjects = {
  "Doing": projects.filter((project) => project.data.status === "Doing"),
  "To Do": projects.filter((project) => project.data.status === "To Do"),
  "Done": projects.filter((project) => project.data.status === "Done"),
  "Backlog": projects.filter((project) => project.data.status === "Backlog"),
  "OBE": projects.filter((project) => project.data.status === "OBE"),
};

const slug = (status: string) => status.toLowerCase().replace(/\s+/g, "-");

const fullDate = (d: Date | string) =>
  new Date(String(d)).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

const shortDate = (d: Date | string) =>
  new Date(String(d)).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

// Statuses that actually have content, used for the nav and the filters
const activeStatuses = Object.entries(groupedProjects).filter(
  ([, items]) => items.length > 0
);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      <header class="animate space-y-3">
        <h1 class="display text-5xl sm:text-6xl">Projects</h1>
        <p class="meta text-base">{projects.length} projects. {PROJECTS.DESCRIPTION}</p>
      </header>

      <div class="relative">

        <aside class="animate absolute bottom-0 top-0 -right-60 hidden w-48 min-[1200px]:block">
          <nav class="sticky top-24 flex h-fit max-h-[calc(100vh-8rem)] flex-col pl-4" aria-label="Filter by status">
            <h2 class="side-label">Filter by status</h2>
            <div class="thin-scroll max-h-[60vh] overflow-y-auto overscroll-contain pr-1">
              <ul class="space-y-1">
                {activeStatuses.map(([status, items]) => (
                  <li>
                    <label class="status-option">
                      <span class="flex min-w-0 items-center gap-2">
                        <input
                          type="checkbox"
                          value={status}
                          data-status-filter
                          class="size-3.5 flex-shrink-0 accent-[var(--c-accent)]"
                        />
                        <span class="truncate text-[0.8rem]">
                          {status}
                        </span>
                      </span>
                      <span class="flex-shrink-0 text-xs tabular-nums text-muted">
                        {items.length}
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
            <button
              type="button"
              data-status-clear
              class="mt-4 hidden text-left text-xs text-muted underline underline-offset-2 transition-colors hover:text-accent-ink"
            >
              Clear filters
            </button>
          </nav>
        </aside>

        <div class="min-w-0 space-y-14">
          {activeStatuses.map(([status, statusProjects]) => (
            <section
              id={slug(status)}
              class="animate scroll-mt-24"
              data-status-group
              data-status={status}
            >
              <h2 class="section-title flex items-baseline justify-between border-b-2 border-ink pb-2 text-2xl">
                {status}
                <span class="meta text-sm font-normal">{statusProjects.length}</span>
              </h2>
              <ul class="divide-y divide-line">
                {statusProjects.map((project) => {
                  const related = blogs
                    .filter((blog) => blog?.data?.linkedProject === `/projects/${project.id}` || blog?.data?.linkedProject === project.id)
                    .sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf());
                  return (
                    <li class="space-y-2 py-6">
                      <a href={`/projects/${project.id}`} class="project-title block text-ink">
                        {project.data.title}
                      </a>
                      <p class="text-[0.95rem] leading-relaxed text-text">{project.data.description}</p>
                      <p class="meta text-xs">
                        Projected {fullDate(project.data.startDate)} to{" "}
                        {project.data.endDate === "TBD" || !project.data.endDate ? "TBD" : fullDate(project.data.endDate)}
                      </p>
                      {related.length > 0 && (
                        <ul class="mt-3 space-y-1.5 border-l-2 border-line pl-4">
                          {related.map((blog) => (
                            <li class="flex flex-wrap items-baseline gap-x-3 text-sm">
                              <a href={`/blog/${blog.id}`} class="link">
                                {blog.data.title}
                              </a>
                              <span class="meta text-xs">{shortDate(blog.data.date)}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>

      </div>
    </div>
  </Container>
</Layout>

<style>
  .project-title {
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 650;
    font-variation-settings: "wdth" 104;
    transition: color 150ms ease;
  }

  .project-title:hover {
    color: var(--c-accent-ink);
  }

  .status-option {
    display: flex;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--c-text);
    transition: background-color 150ms ease;
  }

  .status-option:hover {
    background: color-mix(in srgb, var(--c-line) 45%, transparent);
  }

  .status-option:has(input:checked) {
    color: var(--c-ink);
    background: var(--c-accent-wash);
  }
</style>

<script>
  function initStatusFilter() {
    const boxes = Array.from(
      document.querySelectorAll("input[data-status-filter]")
    ) as HTMLInputElement[];
    if (!boxes.length) return;

    const groups = Array.from(document.querySelectorAll("[data-status-group]"));
    const clearBtn = document.querySelector("[data-status-clear]");

    const apply = () => {
      const selected = boxes.filter((b) => b.checked).map((b) => b.value);

      groups.forEach((group) => {
        const status = group.getAttribute("data-status") || "";
        const match = selected.length === 0 || selected.includes(status);
        group.classList.toggle("hidden", !match);
      });

      // Keep the divider off whichever section lands first
      let first = true;
      groups.forEach((group) => {
        const rule = group.querySelector("[data-status-rule]");
        if (group.classList.contains("hidden")) return;
        if (rule) rule.classList.toggle("hidden", first);
        first = false;
      });

      if (clearBtn) clearBtn.classList.toggle("hidden", selected.length === 0);
    };

    boxes.forEach((b) => b.addEventListener("change", apply));

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        boxes.forEach((b) => (b.checked = false));
        apply();
      });
    }

    apply();
  }

  initStatusFilter();
  document.addEventListener("astro:page-load", initStatusFilter);
</script>