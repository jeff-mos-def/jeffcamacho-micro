---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { PROJECTS } from "@consts";

// Fetch projects and blogs
const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf());

const blogs = (await getCollection("blog"))
  .filter((blog) => !blog.data.draft);

// Group projects by status
const groupedProjects = {
  "Doing": projects.filter((project) => project.data.status === "Doing"),
  "To Do": projects.filter((project) => project.data.status === "To Do"),
  "Done": projects.filter((project) => project.data.status === "Done"),
  "Backlog": projects.filter((project) => project.data.status === "Backlog"),
  "OBE": projects.filter((project) => project.data.status === "OBE"),
};

const slug = (status: string) => status.toLowerCase().replace(/\s+/g, "-");

// Statuses that actually have content, used for the nav and the filters
const activeStatuses = Object.entries(groupedProjects).filter(
  ([, items]) => items.length > 0
);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white text-2xl">
        Projects
      </div>

      <div class="min-[1024px]:grid min-[1024px]:grid-cols-[minmax(0,1fr)_11rem] min-[1024px]:gap-8 min-[1340px]:block min-[1340px]:relative min-[1340px]:w-full">

        <aside class="animate hidden min-[1024px]:block min-[1024px]:col-start-2 min-[1024px]:row-start-1 min-[1340px]:absolute min-[1340px]:top-0 min-[1340px]:bottom-0 min-[1340px]:-right-60 min-[1340px]:w-48">
          <nav class="min-[1024px]:sticky min-[1024px]:top-24 h-fit min-[1024px]:max-h-[calc(100vh-8rem)] flex flex-col space-y-2 pl-4">
            <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-500 mb-4">
              Status
            </h2>
            <div class="max-h-[60vh] overflow-y-auto overscroll-contain pr-1 status-scroll">
              <ul class="space-y-2">
                {activeStatuses.map(([status, items]) => (
                  <li>
                    <label class="flex items-center justify-between gap-2 px-3 py-2 rounded border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors cursor-pointer">
                      <span class="flex items-center gap-2 min-w-0">
                        <input
                          type="checkbox"
                          value={status}
                          data-status-filter
                          class="size-3.5 flex-shrink-0 accent-blue-500"
                        />
                        <span class="text-xs text-neutral-700 dark:text-neutral-300 truncate">
                          {status}
                        </span>
                      </span>
                      <span class="text-xs tabular-nums text-neutral-500 dark:text-neutral-500 flex-shrink-0">
                        {items.length}
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
            <button
              type="button"
              data-status-clear
              class="mt-4 hidden text-xs text-neutral-500 dark:text-neutral-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
            >
              Clear filters
            </button>
          </nav>
        </aside>

        <div class="space-y-8 min-w-0 min-[1024px]:col-start-1 min-[1024px]:row-start-1">
          {Object.entries(groupedProjects).map(([status, statusProjects], index) => (
            <div
              id={slug(status)}
              class="animate space-y-4 scroll-mt-24"
              data-status-group
              data-status={status}
            >
              {index > 0 && (
                <hr class="border-t border-zinc-200 dark:border-zinc-700 pt-4" data-status-rule />
              )}
              <h2 class="text-lg font-semibold text-black dark:text-white underline underline-offset-4">
                {status}
              </h2>
              <ul class="not-prose flex flex-col gap-4">
                {statusProjects.map((project) => (
                  <li>
                    <ArrowCard entry={project} />

                    <div class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                      Projected Start Date: {new Date(String(project.data.startDate)).toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })} - Projected End Date: {project.data.endDate === "TBD" ? "TBD" : new Date(String(project.data.endDate)).toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </div>

                    <ul class="space-y-2 mt-2">
                      {blogs
                        .filter((blog) => blog?.data?.linkedProject === project.id)
                        .map((blog) => (
                          <li>
                            <a href={`/blog/${blog.id}`} class="text-blue-500 underline">
                              {blog.data.title}
                            </a>
                            <div class="text-sm text-zinc-500 dark:text-zinc-400">
                              Published: {new Date(String(blog.data.date)).toLocaleDateString("en-US", {
                                month: "short",
                                day: "numeric",
                                year: "numeric",
                              })}
                            </div>
                          </li>
                        ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

      </div>
    </div>
  </Container>
</Layout>

<style>
  .status-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgb(212 212 212) transparent;
  }
  :global(.dark) .status-scroll {
    scrollbar-color: rgb(64 64 64) transparent;
  }
  .status-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .status-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .status-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(212 212 212);
    border-radius: 9999px;
  }
  :global(.dark) .status-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(64 64 64);
  }
</style>

<script>
  function initStatusFilter() {
    const boxes = Array.from(
      document.querySelectorAll("input[data-status-filter]")
    ) as HTMLInputElement[];
    if (!boxes.length) return;

    const groups = Array.from(document.querySelectorAll("[data-status-group]"));
    const clearBtn = document.querySelector("[data-status-clear]");

    const apply = () => {
      const selected = boxes.filter((b) => b.checked).map((b) => b.value);

      groups.forEach((group) => {
        const status = group.getAttribute("data-status") || "";
        const match = selected.length === 0 || selected.includes(status);
        group.classList.toggle("hidden", !match);
      });

      // Keep the divider off whichever section lands first
      let first = true;
      groups.forEach((group) => {
        const rule = group.querySelector("[data-status-rule]");
        if (group.classList.contains("hidden")) return;
        if (rule) rule.classList.toggle("hidden", first);
        first = false;
      });

      if (clearBtn) clearBtn.classList.toggle("hidden", selected.length === 0);
    };

    boxes.forEach((b) => b.addEventListener("change", apply));

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        boxes.forEach((b) => (b.checked = false));
        apply();
      });
    }

    apply();
  }

  initStatusFilter();
  document.addEventListener("astro:page-load", initStatusFilter);
</script>