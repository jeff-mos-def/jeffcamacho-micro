---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostRow from "@components/PostRow.astro";
import { getCollection } from "astro:content";
import { TAGS } from "@lib/tags";

export async function getStaticPaths() {
  const blogPosts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return TAGS.map((tag) => ({
    params: { id: tag.slug },
    props: {
      tag,
      posts: blogPosts.filter((post) => post.data.tags?.includes(tag.slug)),
    },
  })).filter(({ props }) => props.posts.length > 0);
}

const { tag, posts } = Astro.props;
---

<Layout title={tag.label} description={tag.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/tags">All topics</BackToPrevious>
    </div>
    <header class="animate mb-10 mt-8 space-y-3">
      <h1 class="display text-4xl sm:text-5xl">{tag.label}</h1>
      <p class="font-serif text-lg leading-relaxed text-muted">{tag.description}</p>
      <p class="meta">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    </header>
    <ul class="animate divide-y divide-line border-t border-line">
      {
        posts.map((post) => (
          <li>
            <PostRow post={post} />
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
