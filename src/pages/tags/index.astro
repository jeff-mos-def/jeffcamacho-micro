---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import { TAGS } from "@lib/tags";

const blogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const topics = TAGS.map((tag) => {
  const posts = blogPosts.filter((post) => post.data.tags?.includes(tag.slug));
  return { ...tag, posts };
}).filter((topic) => topic.posts.length > 0);
---

<Layout title="Topics" description="Browse the blog by topic.">
  <Container>
    <header class="animate mb-10 space-y-3">
      <h1 class="display text-5xl sm:text-6xl">Topics</h1>
      <p class="meta text-base">
        {blogPosts.length} posts across {topics.length} topics.
      </p>
    </header>

    <ul class="animate divide-y divide-line border-t border-line">
      {
        topics.map((topic) => (
          <li class="py-6">
            <div class="flex items-baseline justify-between gap-4">
              <a href={`/tags/${topic.slug}`} class="topic-title text-ink">
                {topic.label}
              </a>
              <span class="meta shrink-0">
                {topic.posts.length} {topic.posts.length === 1 ? "post" : "posts"}
              </span>
            </div>
            <p class="mt-1 text-[0.95rem] text-text">{topic.description}</p>
            <ul class="mt-3 space-y-1 text-sm">
              {topic.posts.slice(0, 3).map((post) => (
                <li class="truncate">
                  <a href={`/blog/${post.id}`} class="text-muted transition-colors hover:text-accent-ink">
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>

<style>
  .topic-title {
    font-size: 1.35rem;
    font-weight: 700;
    font-variation-settings: "wdth" 110;
    letter-spacing: -0.01em;
    transition: color 150ms ease;
  }

  .topic-title:hover {
    color: var(--c-accent-ink);
  }
</style>
