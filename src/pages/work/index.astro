---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { WORK } from "@consts";

// Fetch and render work entries
const workEntries = await getCollection("work");

const renderedEntries = await Promise.all(
  workEntries.map(async (entry) => {
    const rendered = await render(entry);
    return { ...entry, Content: rendered.Content };
  })
);

// Sort the rendered entries by `dateEnd` in descending order
const sortedEntries = renderedEntries.sort((a, b) => {
  const aDateEnd = a.data.dateEnd === "Current" ? new Date() : new Date(a.data.dateEnd);
  const bDateEnd = b.data.dateEnd === "Current" ? new Date() : new Date(b.data.dateEnd);
  return bDateEnd.getTime() - aDateEnd.getTime();
});

const workItems = sortedEntries.filter((entry) => entry.data.type === "work");
const entrepreneurialItems = sortedEntries.filter((entry) => entry.data.type === "entrepreneurial");
const volunteerItems = sortedEntries.filter((entry) => entry.data.type === "volunteer");

const sections = [
  { title: "Work Experience", id: "work-experience", items: workItems },
  { title: "Entrepreneurial Experience", id: "entrepreneurial-experience", items: entrepreneurialItems },
  { title: "Volunteer Experience", id: "volunteer-experience", items: volunteerItems },
].filter((section) => section.items.length > 0);

function formatDate(date: Date | string | number): string {
  const parsedDate = new Date(date);
  return parsedDate.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
}
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <header class="animate mb-12 space-y-3">
      <h1 class="display text-5xl sm:text-6xl">Work</h1>
      <p class="meta text-base">{WORK.DESCRIPTION}.</p>
    </header>

    <div class="relative">

      <aside class="animate absolute bottom-0 top-0 -left-60 hidden w-48 min-[1200px]:block" data-pagefind-ignore>
        <nav class="sticky top-24 h-fit pr-4" aria-label="Sections">
          <h2 class="side-label">Sections</h2>
          <ul class="space-y-1.5 border-l border-line pl-3">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="flex items-start justify-between gap-2 text-sm text-text transition-colors hover:text-accent-ink"
                >
                  <span>{section.title}</span>
                  <span class="pt-0.5 text-xs tabular-nums text-muted">
                    {section.items.length}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="space-y-16" data-pagefind-ignore>
        {sections.map((section) => (
          <section id={section.id} class="animate scroll-mt-24">
            <h2 class="section-title mb-8 flex items-baseline justify-between border-b-2 border-ink pb-2 text-2xl">
              {section.title}
              <span class="meta text-sm font-normal">{section.items.length}</span>
            </h2>
            <ol class="timeline">
              {section.items.map((entry) => (
                <li id={entry.id} class="timeline-entry scroll-mt-28" data-current={entry.data.dateEnd === "Current" ? "true" : undefined}>
                  <span class="timeline-dot" aria-hidden="true" />
                  <p class="meta text-xs">
                    {formatDate(entry.data.dateStart)} to{" "}
                    {entry.data.dateEnd === "Current" ? "Current" : formatDate(entry.data.dateEnd)}
                  </p>
                  <h3 class="entry-company">{entry.data.company}</h3>
                  <p class="text-[0.95rem] text-muted">{entry.data.role}</p>
                  <div class="prose mt-3 max-w-none font-serif text-[1.02rem] leading-relaxed">
                    <entry.Content />
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

    </div>
  </Container>
</Layout>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 2.25rem;
    padding-left: 2rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 3px;
    background: var(--c-line-strong);
  }

  .timeline-entry {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 0.2rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 9999px;
    border: 3px solid var(--c-accent);
    background: var(--c-paper);
  }

  .timeline-entry[data-current] .timeline-dot {
    background: var(--c-accent);
    box-shadow: 0 0 0 4px var(--c-accent-wash);
  }

  .timeline-entry:target .entry-company {
    color: var(--c-accent-ink);
  }

  .entry-company {
    margin-top: 0.15rem;
    color: var(--c-ink);
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 650;
    font-variation-settings: "wdth" 106;
  }
</style>
