---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { WORK } from "@consts";

// Fetch and render work entries
const workEntries = await getCollection("work");

const renderedEntries = await Promise.all(
  workEntries.map(async (entry) => {
    const rendered = await render(entry);
    return { ...entry, Content: rendered.Content };
  })
);

// Sort the rendered entries by `dateEnd` in descending order
const sortedEntries = renderedEntries.sort((a, b) => {
  const aDateEnd = a.data.dateEnd === "Current" ? new Date() : new Date(a.data.dateEnd);
  const bDateEnd = b.data.dateEnd === "Current" ? new Date() : new Date(b.data.dateEnd);
  return bDateEnd.getTime() - aDateEnd.getTime();
});

const workItems = sortedEntries.filter((entry) => entry.data.type === "work");
const entrepreneurialItems = sortedEntries.filter((entry) => entry.data.type === "entrepreneurial");
const volunteerItems = sortedEntries.filter((entry) => entry.data.type === "volunteer");

const sections = [
  { title: "Work Experience", id: "work-experience", count: workItems.length },
  { title: "Entrepreneurial Experience", id: "entrepreneurial-experience", count: entrepreneurialItems.length },
  { title: "Volunteer Experience", id: "volunteer-experience", count: volunteerItems.length },
].filter((section) => section.count > 0);

function formatDate(date: Date | string | number): string {
  const parsedDate = new Date(date);
  return parsedDate.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
}
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <div class="min-[1024px]:grid min-[1024px]:grid-cols-[11rem_minmax(0,1fr)] min-[1024px]:gap-8 min-[1340px]:block min-[1340px]:relative min-[1340px]:w-full">

      <aside class="animate hidden min-[1024px]:block min-[1340px]:absolute min-[1340px]:top-0 min-[1340px]:bottom-0 min-[1340px]:-left-60 min-[1340px]:w-48" data-pagefind-ignore>
        <nav class="min-[1024px]:sticky min-[1024px]:top-24 h-fit space-y-2 pr-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-500 mb-4">
            Sections
          </h2>
          <ul class="space-y-1.5 pl-3 border-l border-neutral-200 dark:border-neutral-800">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="flex items-start justify-between gap-2 text-sm text-neutral-700 dark:text-neutral-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
                >
                  <span>{section.title}</span>
                  <span class="text-xs tabular-nums text-neutral-500 dark:text-neutral-500 pt-0.5">
                    {section.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <aside data-pagefind-ignore>
        {/* Work Experience Section */}
        <div id="work-experience" class="space-y-6 scroll-mt-24">
          <h2 class="animate text-lg font-semibold text-zinc-800 dark:text-zinc-200 underline underline-offset-4">
            Work Experience
          </h2>
          <ul class="animate not-prose flex flex-col gap-8">
            {workItems.map((entry) => (
              <li class="space-y-2">
                <div class="text-sm text-zinc-500 dark:text-zinc-400">
                  {formatDate(entry.data.dateStart)} -{" "}
                  {entry.data.dateEnd === "Current" ? "Current" : formatDate(entry.data.dateEnd)}
                </div>
                <div class="text-lg text-zinc-800 dark:text-zinc-100">{entry.data.company}</div>
                <div class="text-zinc-500 dark:text-zinc-400">{entry.data.role}</div>
                <div class="prose dark:prose-invert">
                  <entry.Content />
                </div>
              </li>
            ))}
          </ul>
        </div>
        <br /><br />
        {/* Divider */}
        <hr class="border-t border-zinc-200 dark:border-zinc-700" />
        <br /><br />
        {/* Entrepreneurial Experience Section */}
        <div id="entrepreneurial-experience" class="space-y-6 scroll-mt-24">
          <h2 class="animate text-lg font-semibold text-zinc-800 dark:text-zinc-200 underline underline-offset-4">
            Entrepreneurial Experience
          </h2>
          <ul class="animate not-prose flex flex-col gap-8">
            {entrepreneurialItems.map((entry) => (
              <li class="space-y-2">
                <div class="text-sm text-zinc-500 dark:text-zinc-400">
                  {formatDate(entry.data.dateStart)} -{" "}
                  {entry.data.dateEnd === "Current" ? "Current" : formatDate(entry.data.dateEnd)}
                </div>
                <div class="text-lg text-zinc-800 dark:text-zinc-100">{entry.data.company}</div>
                <div class="text-zinc-500 dark:text-zinc-400">{entry.data.role}</div>
                <div class="prose dark:prose-invert">
                  <entry.Content />
                </div>
              </li>
            ))}
          </ul>
        </div>
        <br /><br />
        {/* Divider */}
        <hr class="border-t border-zinc-200 dark:border-zinc-700" />
        <br /><br />
        {/* Volunteer Experience Section */}
        <div id="volunteer-experience" class="space-y-6 scroll-mt-24">
          <h2 class="animate text-lg font-semibold text-zinc-800 dark:text-zinc-200 underline underline-offset-4">
            Volunteer Experience
          </h2>
          <ul class="animate not-prose flex flex-col gap-8">
            {volunteerItems.map((entry) => (
              <li class="space-y-2">
                <div class="text-sm text-zinc-500 dark:text-zinc-400">
                  {formatDate(entry.data.dateStart)} -{" "}
                  {entry.data.dateEnd === "Current" ? "Current" : formatDate(entry.data.dateEnd)}
                </div>
                <div class="text-lg text-zinc-800 dark:text-zinc-100">{entry.data.company}</div>
                <div class="text-zinc-500 dark:text-zinc-400">{entry.data.role}</div>
                <div class="prose dark:prose-invert">
                  <entry.Content />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>

    </div>
  </Container>
</Layout>